# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which holds no secrets and is the setup instructions
# for the rental contract mailer.
!.env.local.example
!.env.preview.template

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma client, generated from prisma/schema.prisma
# Prisma 7 generates into the project rather than into node_modules, so it has
# to be ignored explicitly. `pnpm install` and `pnpm build` both regenerate it.
/generated/

out.zip

# duplicate extracted copy of the site (identical to working tree) and its archive
/New folder/
website.rar

# windows/cygwin crash dumps
*.stackdump