// The rental system's data model.
//
// Extends the schema from the earlier project at D:\Personal\zuriauto for
// fixed-term rentals and for everything the pickup wizard already captures.
// See docs/superpowers/specs/2026-08-16-rental-persistence-design.md.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CarStatus {
  available
  rented
  maintenance
  retired
}

enum RentalType {
  WEEKLY
  FIXED_TERM
}

enum RentalStatus {
  ACTIVE
  EXTENSION_REQUESTED
  RETURN_SUBMITTED
  COMPLETED
  CANCELLED
}

enum ContractKind {
  PICKUP
  RETURN_ADDENDUM
}

/// How the car came back. Spelled out rather than a boolean: "not clean" and
/// "needs a wash we will charge for" are the same fact, and the office bills
/// on it.
enum Cleanliness {
  clean
  needsWash
}

// Spelled out rather than fractional: a Prisma enum cannot contain a slash.
// The mapping to and from "1/4" lives in lib/rental/fleet.ts, beside the
// function that prints it, so the two representations cannot drift apart.
enum FuelLevel {
  empty
  quarter
  half
  three_quarter
  full
}

enum AssetKind {
  PORTRAIT
  ID_FRONT
  ID_BACK
  LICENCE_FRONT
  LICENCE_BACK
  CONDITION_PHOTO
  SIGNATURE
  DAMAGE_PHOTO
}

enum AdminRole {
  owner
  staff
}

/// One row for the foreseeable future. Present so that a tenant key exists on
/// every table from the first migration rather than being retrofitted, which
/// would mean rewriting every query and every access check.
model Organisation {
  id         String            @id @default(cuid())
  name       String
  createdAt  DateTime          @default(now())
  cars       Car[]
  customers  Customer[]
  rentals    Rental[]
  contracts  Contract[]
  counters   ContractCounter[]
  adminUsers AdminUser[]
}

model Car {
  id String @id @default(cuid())

  organisationId     String
  /// Mirrors FleetVehicle.id in lib/rental/fleet.ts. The seed reconciles on it.
  slug               String
  model              String
  plate              String
  vin                String?
  /// Owned by the database, never by the seed: a car is taken out of service
  /// by the office, without a deploy.
  status             CarStatus @default(available)
  /// Reserved for Phase 6. Nothing is built against it until trackers exist.
  telematicsDeviceId String?

  /// When this car's annual technical inspection (MFK) falls due.
  ///
  /// A date, not an instant: it is a day on a Swiss calendar, and the office
  /// types it off a letter. Nullable because a car whose date nobody has
  /// recorded must simply never trigger a reminder — an inspection the system
  /// invents is worse than one it stays quiet about.
  ///
  /// Owned by the office and re-entered after each inspection. Nothing rolls
  /// it forward automatically: a year is the usual interval but not a
  /// guaranteed one, and a wrong date here takes a car off the road.
  mfkDate DateTime? @db.Date

  /// ---------------------------------------------------------------------
  /// The service book.
  ///
  /// Three numbers rather than one "next service" date, because a garage
  /// schedules on distance and the office reads distance off the dashboard.
  /// A date would have to be guessed from an assumed monthly mileage, and a
  /// car that spends a month on the forecourt would be sent for a service it
  /// does not need — while a taxi doing 4'000 km a month would miss one.
  ///
  /// All nullable, and for the reason `mfkDate` is: a car whose figures
  /// nobody has entered must be silent, not wrong. A service the system
  /// invents is worse than one it stays quiet about.
  /// ---------------------------------------------------------------------

  /// The odometer as last read, in kilometres. Whole kilometres: the
  /// dashboard does not show more and a decimal here would imply a precision
  /// the reading does not have.
  currentMileageKm Int?

  /// When `currentMileageKm` was read.
  ///
  /// Stored rather than inferred from `updatedAt`, which any edit would move.
  /// Without it the screen cannot distinguish "97'000 km, read this morning"
  /// from "97'000 km, read in March" — and the second is a number the office
  /// should not plan a service against.
  mileageReadAt DateTime?

  /// The odometer at the last service.
  serviceDoneKm Int?
  /// The day of the last service, as the invoice states it.
  serviceDoneOn DateTime? @db.Date
  /// The odometer at which the next service falls due.
  ///
  /// Typed from the garage's sticker, never computed from an interval: the
  /// interval differs by model and by how the car is driven, and a number
  /// this system derived would quietly disagree with the windscreen.
  serviceDueKm Int?

  /// ---------------------------------------------------------------------
  /// The photograph shown beside the car in a picker.
  ///
  /// A key into the same object store the identity documents use, but
  /// deliberately *not* an `Asset` row. An Asset belongs to a Contract and is
  /// on a retention clock that deletes it five years after the rental; a car
  /// photograph is reference data with no subject, no retention obligation
  /// and no contract to hang from. Putting it in that table would have meant
  /// the sweep eventually deleting the fleet's photographs.
  ///
  /// Three columns rather than one: the content type is needed to serve the
  /// bytes back, and the stamp is what the public photo endpoint turns into
  /// an ETag so a replaced photograph is not served from a cache for a week.
  /// ---------------------------------------------------------------------
  photoKey         String?
  photoContentType String?
  photoUpdatedAt   DateTime?

  organisation  Organisation      @relation(fields: [organisationId], references: [id])
  rentals       Rental[]
  notifications CarNotification[]
  repairs       CarRepair[]

  @@unique([organisationId, plate])
  @@unique([organisationId, slug])
  /// The daily MFK pass's query: the dated cars, soonest first.
  @@index([organisationId, mfkDate])
}

/// Whether a repair has happened or is still owed.
enum RepairStatus {
  planned
  done
}

/// One repair, planned or carried out.
///
/// A table rather than the two free-text fields the client's sketch showed
/// ("Repairs_done: bumpers, back right wheel replaced" / "Repairs-planned:
/// windshield"). Two text boxes cannot answer when something was done, cannot
/// be sorted, and lose the previous entry every time somebody types over
/// them — and a car's repair history is exactly what an insurer, a buyer or a
/// damage dispute asks for.
///
/// So each repair is a row, and "planned" and "done" are one lifecycle rather
/// than two lists: marking a planned repair done keeps the line that recorded
/// it being planned, which is how the office can later see that the
/// windscreen was flagged in September and replaced in November.
model CarRepair {
  id String @id @default(cuid())

  organisationId String
  carId          String

  status RepairStatus @default(planned)

  /// What was or will be done, in the office's own words. Free text on
  /// purpose: a taxonomy of repair types would be wrong within a week and
  /// nobody would maintain it.
  details String

  /// The day this is planned for, when one has been agreed. Nullable because
  /// "the windscreen needs doing" is a real entry before a garage slot exists.
  plannedFor DateTime? @db.Date
  /// The day it was carried out. Set when the status becomes `done`, and the
  /// only thing that makes the repair history a chronology.
  doneOn     DateTime? @db.Date

  /// The odometer when it was done, so a repair can be placed against the
  /// service history rather than only against the calendar.
  mileageKm Int?
  /// What it cost, in cents, as money is stored everywhere else here.
  costCents Int?

  /// The account that entered it. Denormalised for the reason AssetAccess
  /// gives: an account can be disabled, and who recorded a repair should
  /// outlive it.
  createdBy String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Cascades, unlike every other relation to Car. A repair is a note about
  /// a vehicle and has no independent meaning; the delete it cascades from is
  /// only ever reachable for a car with no rental history at all — see the
  /// DELETE handler, which refuses anything a contract points at.
  car Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  /// The fleet screen's query: this car's repairs, newest first.
  @@index([carId, status, createdAt])
}

/// Somebody who asked to be told when a car frees up.
///
/// The whole fleet can be out at once — ten cars and a good week is all it
/// takes — and the booking page's honest answer then is "nothing today". A
/// customer who reads that and leaves is a customer lost to a page that could
/// have taken their address in one field.
///
/// One row per address, rewritten rather than duplicated: somebody who asks
/// twice is asking once. `notifiedAt` is both the record of the send and the
/// idempotency — the pass claims a row with a conditional update whose WHERE
/// repeats `notifiedAt: null`, exactly as the lifecycle passes do, so two
/// concurrent runs cannot both mail the same person.
model AvailabilityAlert {
  id String @id @default(cuid())

  organisationId String

  /// Always stored lowercased and trimmed, as Customer.email is. The unique
  /// key is on this, so the casing somebody typed cannot create a second row.
  email String

  /// Which language to write in. The site is German by default and the
  /// notice is sent without the customer present to switch it.
  language String @default("de")

  /// The single-use string in the unsubscribe link.
  ///
  /// Random and unguessable, so the link in one person's mail cannot be
  /// edited into another's. Stored in the clear, unlike ActionToken's hash:
  /// this token authorises removing an address from a mailing list and
  /// nothing else, and a link that cannot be resolved after a database dump
  /// would mean an unsubscribe that silently fails.
  unsubscribeToken String @unique

  /// When the availability mail went out. Null means "still waiting", which
  /// is what the pass selects on.
  notifiedAt DateTime?
  /// Set when the address is removed, by the unsubscribe link or by the
  /// office. The row survives so that a later re-subscribe is visibly a
  /// second request rather than a resurrection nobody can see.
  cancelledAt DateTime?

  createdAt DateTime @default(now())

  @@unique([organisationId, email])
  /// The pass's query: everybody still waiting.
  @@index([organisationId, notifiedAt, cancelledAt])
}

/// A message about a car rather than about a rental.
///
/// Deliberately its own table rather than a nullable `rentalId` on
/// Notification. Postgres treats NULLs as *distinct* in a unique index, so
/// `[NULL, kind, dedupeKey]` would insert over and over and the office would
/// be told about the same inspection every morning — the idempotency would
/// fail silently, which is the worst way for it to fail. A separate table
/// keeps `[carId, kind, dedupeKey]` genuinely unique and leaves the rental
/// notifications untouched.
///
/// The columns mirror Notification for the reason given there: the unique key
/// guards the *decision* to send, and `sentAt` / `error` / `attempts` record
/// the *outcome*.
model CarNotification {
  id             String @id @default(cuid())
  organisationId String
  carId          String

  kind CarNotificationKind
  /// The inspection date this message is about, as Zurich reckons the day.
  /// Keyed to the date rather than the run, so correcting an MFK date
  /// correctly permits a fresh warning — and re-running the pass does not.
  dedupeKey String
  to        String

  sentAt   DateTime?
  error    String?
  attempts Int       @default(0)

  createdAt DateTime @default(now())

  car Car @relation(fields: [carId], references: [id])

  @@unique([carId, kind, dedupeKey])
  @@index([sentAt, attempts])
}

model Customer {
  id String @id @default(cuid())

  organisationId String
  firstName      String
  lastName       String
  /// Always stored lowercased and trimmed. See lib/rental/customers.ts.
  email          String
  phone          String
  /// E.164, written by normalisePhone(). The desk lookup's key.
  ///
  /// Deliberately not unique: one mobile can belong to a couple, and a UNIQUE
  /// migration is one that can fail on data already in the table. A lookup
  /// returns several matches and the staff member picks.
  ///
  /// Nullable because the backfill script populates it, not the migration —
  /// the normaliser is TypeScript, and reimplementing it as SQL regex would
  /// give one rule two implementations that drift. Null also means "this
  /// number could not be normalised", which is a real state and correctly
  /// unfindable.
  phoneKey       String?
  birthDate      DateTime @db.Date
  street         String
  postalCode     String
  city           String
  country        String
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id])
  rentals      Rental[]

  @@unique([organisationId, email])
  @@index([organisationId, phoneKey])
}

model Rental {
  id String @id @default(cuid())

  organisationId String
  carId          String
  customerId     String
  /// "office" until Phase 5 brings named accounts. Written from the first day
  /// because attribution cannot be recovered for rows already recorded, and
  /// these are exactly the rows a fine or a dispute reaches back into.
  createdBy      String

  type   RentalType
  status RentalStatus @default(ACTIVE)

  startAt DateTime
  /// Written, never computed on read, so the Phase 3 reminder pass is a plain
  /// indexed range scan. Derived for WEEKLY, explicit for FIXED_TERM.
  endAt   DateTime

  currency     String @default("chf")
  depositCents Int    @default(0)

  weeklyAmountCents Int?
  totalWeeks        Int?
  billingWeekday    Int?

  totalAmountCents Int?

  createdAt DateTime @default(now())

  organisation  Organisation   @relation(fields: [organisationId], references: [id])
  car           Car            @relation(fields: [carId], references: [id])
  customer      Customer       @relation(fields: [customerId], references: [id])
  contracts     Contract[]
  events        RentalEvent[]
  charges       Charge[]
  notifications Notification[]
  tokens        ActionToken[]

  @@index([organisationId, status, endAt])
  @@index([carId, startAt, endAt])
}

/// A signed document. Two kinds share this table: the pickup contract and the
/// return addendum Phase 4 adds.
///
/// Mileage, fuel level and damage notes belong here rather than on Rental
/// precisely so the return can be a comparison against the pickup's baseline
/// instead of an overwrite of it.
model Contract {
  id String @id @default(cuid())

  organisationId String
  rentalId       String
  contractNumber String
  createdBy      String
  kind           ContractKind

  mileageKm   Int
  fuelLevel   FuelLevel
  damageNotes String    @default("")

  gtcVersion  String
  gtcLanguage String
  acceptedAt  DateTime

  place    String   @default("")
  signedAt DateTime @default(now())

  pdfKey     String?
  mailSentAt DateTime?
  mailError  String?

  /// ---------------------------------------------------------------------
  /// The return protocol.
  ///
  /// Null on a PICKUP contract, which is why every one of these is optional
  /// rather than defaulted: a pickup has no opinion about whether the key
  /// came back, and a `false` would claim it did not.
  ///
  /// These were collected by the return form and validated from the first
  /// day it existed, but reached only the PDF. The office was asked to
  /// confirm a return — the click that frees the car — while every answer
  /// that decides whether money is owed sat in a document in a bucket.
  /// ---------------------------------------------------------------------
  cleanliness  Cleanliness?
  papersInside Boolean?
  keyReturned  Boolean?

  /// Traffic fines the renter declares. The note is free text off the paper
  /// protocol; empty is the normal case, so it defaults rather than nulls.
  tickets     Boolean?
  ticketsNote String   @default("")

  /// The Abrechnung. Amounts in cents, as everywhere else money is stored.
  fullyPaid       Boolean?
  paymentMethods  String[]
  paidAmountCents Int?
  paidOn          DateTime?

  /// What the renter says is still owed, and when. Recorded here as a claim,
  /// not as a debt: it becomes a Charge only when the office confirms the
  /// return, so nobody is chased over a number a customer typed unreviewed.
  hasDuePayment  Boolean?
  dueAmountCents Int?
  dueDate        DateTime?
  dueMethod      String?

  depositBack Boolean?

  /// Set when identity documents were carried forward from an earlier contract
  /// instead of photographed at this handover.
  documentsReusedFromId String?
  /// When the staff member confirmed they had seen the original ID and licence.
  /// Required whenever documentsReusedFromId is set; null on a first rental,
  /// where the fresh photograph is itself the evidence someone looked.
  identityCheckedAt     DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id])
  rental       Rental       @relation(fields: [rentalId], references: [id])
  assets       Asset[]

  documentsReusedFrom Contract?  @relation("DocumentReuse", fields: [documentsReusedFromId], references: [id])
  documentsReusedBy   Contract[] @relation("DocumentReuse")

  @@unique([organisationId, contractNumber])
  @@index([rentalId])
}

model Asset {
  id String @id @default(cuid())

  contractId  String
  kind        AssetKind
  /// Opaque, and deliberately meaningless. See lib/storage/keys.ts.
  storageKey  String    @unique
  contentType String
  bytes       Int
  createdAt   DateTime  @default(now())

  /// When the bytes were deleted under the retention policy.
  ///
  /// The row survives its object on purpose. An Asset is the record that a
  /// passport *was* photographed and checked at that handover — evidence the
  /// office may need long after the image itself must be gone. Deleting the
  /// row would destroy that proof along with the data protection it provides.
  ///
  /// So: storageKey stays (it is opaque and meaningless — see
  /// lib/storage/keys.ts), bytes stay as the recorded size, and this stamp is
  /// what says the object is no longer there. Nothing re-reads a deleted
  /// asset; the documents endpoint refuses it.
  deletedAt DateTime?

  contract Contract @relation(fields: [contractId], references: [id])

  @@index([contractId])
  /// The retention sweep's query: the undeleted ones, oldest first.
  @@index([deletedAt, createdAt])
}

/// Who opened an identity document, and when.
///
/// The same reasoning as CustomerLookup, which logs every phone search
/// including the ones that matched nothing: a passport scan is the
/// highest-risk data in the system, and an office tool that can show one
/// should be able to say who did. Written before the bytes are served, so a
/// read that fails halfway is still recorded as attempted.
model AssetAccess {
  id String @id @default(cuid())

  /// Exactly one of these is set.
  ///
  /// The contract PDF is here too, and not as an afterthought: contractPdf.ts
  /// embeds the portrait, both sides of the ID and both sides of the licence
  /// into it. A PDF endpoint outside this log would be a way to read every
  /// identity image in the system without leaving a trace, which would make
  /// the rest of this table decorative.
  assetId    String?
  contractId String?

  /// Denormalised on purpose. An account can be deleted; the record of who
  /// looked at somebody's passport should outlive it.
  userId   String
  username String

  createdAt DateTime @default(now())

  @@index([assetId])
  @@index([contractId])
  @@index([createdAt])
}

model RentalEvent {
  id String @id @default(cuid())

  rentalId  String
  type      String
  payload   Json?
  createdAt DateTime @default(now())

  rental Rental @relation(fields: [rentalId], references: [id])

  @@index([rentalId, createdAt])
}

/// Client IPs are hashed, never stored, so the rate limiter is not itself a
/// store of personal data.
model SubmissionAttempt {
  id String @id @default(cuid())

  ipHash    String
  /// Which fence recorded this attempt: "pickup", "signin".
  ///
  /// Added in Phase 5. A shared budget lets a burst against one endpoint
  /// starve another — the reasoning already written in
  /// app/api/rental-return/route.ts for keeping that route's limiter its own.
  scope     String   @default("pickup")
  createdAt DateTime @default(now())

  @@index([scope, ipHash, createdAt])
}

/// One row per desk lookup, so "who looked up whom" is answerable without the
/// audit log becoming a second copy of the customer list. The number is salted
/// and hashed exactly as an IP is in lib/rental/rateLimit.ts.
model CustomerLookup {
  id String @id @default(cuid())

  phoneHash String
  matches   Int
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// One row per vehicle-history search, for the same reason CustomerLookup
/// exists: the screen it backs answers "who had this car on the 12th" with a
/// past renter's name, mobile and email, and an office tool that can produce
/// that should be able to say who asked.
///
/// Written whether or not anything matched. A run of searches that find
/// nobody is exactly the shape of somebody walking the fleet, and skipping
/// those rows would leave the trawl invisible.
model CarHistoryLookup {
  id String @id @default(cuid())

  carId String

  /// Denormalised, exactly as on AssetAccess: an account can be disabled or
  /// deleted, and the record of who read a past renter's contact details has
  /// to outlive it. The username rather than the display name — two people
  /// can be called "Ahmed".
  userId   String
  username String

  /// The window that was asked about. Both null when the whole history was
  /// requested, which is a different search from a window that happened to
  /// match everything.
  windowFrom DateTime?
  windowTo   DateTime?

  /// How many periods came back. Zero is the interesting value.
  matches Int

  createdAt DateTime @default(now())

  @@index([carId, createdAt])
  @@index([createdAt])
}

/// The sequence behind ZA-YYYYMMDD-NNNN.
///
/// One row per organisation per day, incremented atomically inside the
/// contract transaction so two simultaneous handovers cannot collide on a
/// number. Not in the design spec, which assumed a sequence without naming
/// where it lives.
model ContractCounter {
  organisationId String
  /// "YYYYMMDD", as Zurich reckons the day.
  day            String
  value          Int    @default(0)

  organisation Organisation @relation(fields: [organisationId], references: [id])

  @@id([organisationId, day])
}

// ---------------------------------------------------------------------
// Phase 3 — lifecycle automation.
// See docs/superpowers/specs/2026-08-18-rental-lifecycle-design.md
// ---------------------------------------------------------------------

enum ChargeStatus {
  SCHEDULED
  REQUESTED
  REMINDED
  OVERDUE
  PAID
  VOID
}

enum NotificationKind {
  RENTAL_ENDING
  RENTAL_OVERDUE
  CHARGE_REQUESTED
  CHARGE_REMINDER
  CHARGE_OVERDUE
  EXTENSION_CONFIRMED
  RETURN_INTENT
}

enum ActionTokenPurpose {
  MANAGE_RENTAL
}

/// Why the office is being written to about a car.
enum CarNotificationKind {
  MFK_DUE
}

/// One payable amount against a rental.
model Charge {
  id             String @id @default(cuid())
  organisationId String
  rentalId       String

  /// 1-based. Extensions continue the sequence rather than restarting it.
  weekNumber  Int
  dueDate     DateTime
  amountCents Int
  currency    String   @default("chf")

  status          ChargeStatus @default(SCHEDULED)
  paymentUrl      String?
  providerRef     String?
  requestedAt     DateTime?
  remindedAt      DateTime?
  officeAlertedAt DateTime?
  paidAt          DateTime?
  createdAt       DateTime     @default(now())

  rental Rental @relation(fields: [rentalId], references: [id])

  /// The old project's rule, kept: two runs cannot create two week-3 charges.
  @@unique([rentalId, weekNumber])
  @@index([status, dueDate])
}

/// Every email the system decides to send.
///
/// The unique constraint is the idempotency, not a boolean flag. A pass inserts
/// the row before sending, so a unique violation means somebody already decided
/// to send this and the pass moves on. A boolean set after the send would let
/// two concurrent runs both read false and both send.
model Notification {
  id             String @id @default(cuid())
  organisationId String
  rentalId       String

  kind      NotificationKind
  /// What makes this send distinct — the Zurich day of an endAt, a week
  /// number. Never a timestamp, which would be unique on every run and so
  /// would dedupe nothing.
  dedupeKey String
  to        String

  sentAt   DateTime?
  error    String?
  attempts Int       @default(0)

  createdAt DateTime @default(now())

  rental Rental @relation(fields: [rentalId], references: [id])

  @@unique([rentalId, kind, dedupeKey])
  @@index([sentAt, attempts])
}

/// A single-use link that authenticates a renter who has no account.
///
/// Deliberately not APPLY_SECRET, which is an office credential. Mailing
/// customers that key would give every past renter permanent write access to
/// the system of record.
model ActionToken {
  id             String @id @default(cuid())
  organisationId String
  rentalId       String

  purpose   ActionTokenPurpose
  /// SHA-256 of the token. The token itself exists only in the email, so a
  /// database dump does not hand over a set of live links.
  tokenHash String             @unique

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  rental Rental @relation(fields: [rentalId], references: [id])

  @@index([rentalId, purpose])
}

// ---------------------------------------------------------------------
// Phase 5, stage 1 — accounts for the fleet dashboard.
// See docs/superpowers/specs/2026-08-28-admin-accounts-design.md
// ---------------------------------------------------------------------

/// A person who can sign into the fleet page.
///
/// Disabled, never deleted: a rental event saying this person closed a rental
/// has to keep resolving after they leave the company.
model AdminUser {
  id             String @id @default(cuid())
  organisationId String

  /// Lowercased and trimmed on write. `[a-z0-9._-]{3,32}`.
  username    String
  /// What attribution shows, e.g. "Eng Ahmed".
  displayName String
  role        AdminRole @default(staff)

  /// `scrypt$N$r$p$salt$hash`. See lib/admin/password.ts.
  passwordHash String

  /// Set to disable. Read on every request, so it takes effect at once.
  disabledAt DateTime?

  /// Bumped when the password changes, which invalidates every cookie issued
  /// before it.
  ///
  /// Deliberately not bumped on a role change: the cookie carries no role, so
  /// a demotion is already in force on the demoted person's next request.
  credentialsChangedAt DateTime @default(now())

  lastSignInAt DateTime?
  createdAt    DateTime  @default(now())
  /// The owner who created this account. Null for the seeded one.
  createdById  String?

  organisation Organisation @relation(fields: [organisationId], references: [id])

  @@unique([organisationId, username])
  @@index([organisationId, disabledAt])
}
