# Preview environment for Vercel — fill in, then run scripts/set-preview-env.sh
#
# Copy to `.env.preview` first. `.gitignore` excludes `.env*`, so the filled-in
# copy is never committed; this template is safe because it holds no values.
#
#   cp .env.preview.template .env.preview
#   # fill in the four blanks below
#   pnpm exec vercel login
#   pnpm exec vercel link
#   bash scripts/set-preview-env.sh
#
# Every value here is for PREVIEW ONLY. Generate a separate set for Production.

# --- You must supply these ------------------------------------------------

# Neon pooled connection string. Use a SEPARATE BRANCH from production: the
# test run creates contracts and then deletes them, and against the production
# database those are ten-year commercial records under OR 958f.
DATABASE_URL=

# Cloudflare R2. The bucket must be created with an EU jurisdiction:
#   wrangler r2 bucket create zuriauto-assets --jurisdiction eu
# The token should be scoped to this bucket only, with object read/write.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Already decided ------------------------------------------------------

R2_BUCKET=zuriauto-assets
ORGANISATION_NAME=ZURIAUTO

# Generated 2026-08-28, all four distinct. Rotate before production.
# APPLY_SECRET no longer fences any route — /pickup/ is open. It still signs
# the returning-customer document-reuse token, so it must stay set.
# ADMIN_SECRET must never equal it: one signs tokens in a public customer flow,
# the other can rewrite the fleet.
APPLY_SECRET=809a4678-63b2-4c3f-825f-ff32732d7859
RATE_LIMIT_SALT=95a262de-cc94-4472-bf90-d455f7ec3272
ADMIN_SECRET=908701ac-8506-4c13-a2b0-3027b27517be
CRON_SECRET=e8347d0c-8777-4458-b17c-c4441eee5e8e

# --- Mail: copy the values already in Production --------------------------
# The preview sends real email. Point MAIL_OFFICE at your own address while
# testing so the office is not copied on every trial contract.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_OFFICE=
MAIL_ARCHIVE=

# SITE_URL is deliberately absent. Unset, the cron and the emails fall back to
# the request host, so a preview links back to itself. Setting it to the
# production domain would send test reminders to real customers' live links.
