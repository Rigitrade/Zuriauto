# Rental pickup contract — mail configuration
#
# Copy this file to `.env.local` and fill in the real values, then restart the
# dev server. `.gitignore` excludes `.env*`, so `.env.local` is never committed.
# For production the same keys go into the Vercel project settings.

# --- SMTP server ------------------------------------------------------
# Host and port of the mailbox that sends the contract.
#   Infomaniak : mail.infomaniak.com          port 587
#   Hostpoint  : asmtp.mail.hostpoint.ch      port 587
#   Gmail      : smtp.gmail.com               port 587  (needs an App Password)
#   Microsoft  : smtp.office365.com           port 587
SMTP_HOST=
SMTP_PORT=587

# Mailbox login. Usually the full email address.
SMTP_USER=

# Mailbox password. With 2FA enabled this must be an app-specific password,
# not the account password.
SMTP_PASS=

# --- Addresses --------------------------------------------------------
# Sender shown to the recipient. Most providers require this to match
# SMTP_USER, or the message is rejected or marked as spam.
MAIL_FROM=

# Where signed contracts are delivered. Comma-separate for several people.
MAIL_OFFICE=info@zuriauto.ch

# Archive copy, sent blind so the customer never sees this address.
#
# Nothing is stored server-side in Phase 1 — this mailbox is the only durable
# record of a signed contract. If it is left empty, a contract deleted from the
# office inbox is gone for good, including the ID and licence images.
MAIL_ARCHIVE=

# --- Database (Phase 2) -----------------------------------------------
# Local development runs `pnpm db:up` — Postgres 16 in Docker on port 5434.
# Not 5433: the earlier project at D:\Personal\zuriauto already uses that
# port for its own database.
#   postgresql://zuriauto:zuriauto@localhost:5434/zuriauto?schema=public
#
# Production is Neon, pooled connection string, EU region. Storing ID scans
# is a materially different obligation from Phase 1, where nothing was kept
# server-side: the region is not a preference. See docs/DATA-RETENTION.md.
DATABASE_URL=

# Name on the single Organisation row `pnpm db:seed` creates.
ORGANISATION_NAME=ZURIAUTO

# --- Write fence (Phase 2) --------------------------------------------
# The key in the office's /apply link. From Phase 2 that page writes to the
# system of record, so an open endpoint would let anyone create a rental
# against a real plate and poison the traffic-fine lookup.
#
# The office pastes /apply/?k=<this> into WhatsApp. Treat the link itself as
# the credential. NEVER send it to a customer — the renter-facing flows use
# single-use ActionTokens instead. Unset, everything returns 401.
# Generate with: node -e "console.log(crypto.randomUUID())"
APPLY_SECRET=

# Salt for hashing client IPs in the rate limiter, so raw addresses are never
# stored. Any long random string; changing it resets the limiter.
RATE_LIMIT_SALT=

# --- Fleet admin page -------------------------------------------------
# The code that opens /admin, where the office adds, edits and retires cars
# and closes a rental that has come back.
#
# MUST be a different value from APPLY_SECRET. That one is pasted into
# WhatsApp and leaks whenever a link is forwarded; this one can rewrite the
# fleet, so they must not share a value. Exchanged once for an httpOnly
# cookie lasting twelve hours, so it never travels in a URL. Rotating it
# signs everyone out. Unset, /admin cannot be signed into at all.
# Generate with: node -e "console.log(crypto.randomUUID())"
ADMIN_SECRET=

# --- Object storage, Cloudflare R2 (Phase 2) --------------------------
# ID scans, driving licences, the portrait, the signature, condition photos
# and the contract PDF. Create the bucket with an EU jurisdiction:
#   wrangler r2 bucket create zuriauto-assets --jurisdiction eu
#
# Left empty in development, uploads are held in memory and lost on restart.
# Left empty in production, the app refuses to start — a deploy that silently
# discarded every ID scan while reporting success is the worse failure.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# The bucket's jurisdiction, which decides the S3 host. A jurisdiction-pinned
# bucket does not answer on the account's ordinary hostname, so leaving this
# wrong is not a permissions error — it is NoSuchBucket, a 503, and a contract
# that was signed and never recorded.
#
# Defaults to `eu` when unset, because that is the only bucket this project is
# permitted to use. Set it to `none` only for a bucket created without a
# jurisdiction.
R2_JURISDICTION=

# --- Scheduler (Phase 3) ----------------------------------------------
# Bearer token the daily cron must present. Without it the endpoint returns
# 401 and nothing runs — it sends email to real customers, so it fails closed.
# Generate with: node -e "console.log(crypto.randomUUID())"
CRON_SECRET=

# Absolute base for links inside emails, with no trailing slash, e.g.
# https://zuriauto.ch. Falls back to the request host, which keeps preview
# deployments pointing at themselves.
SITE_URL=

# How long to wait before chasing an unpaid weekly charge, and then before
# telling the office. Defaults shown.
CHARGE_REMIND_AFTER_HOURS=72
CHARGE_ALERT_AFTER_HOURS=48
